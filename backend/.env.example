# Runtime environment: development or production.
NODE_ENV=development

# Express listens on all interfaces in the server entry point.
PORT=8080

# Local development path. In production, set this explicitly to /data/2048.db
# on the mounted Fly Volume. The production server never invents a fallback.
DATABASE_PATH=./data/2048.db

# Comma-separated exact browser origins allowed by CORS.
# Example: https://your-github-pages-site.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# In-memory per-IP rate limit. Configure window in milliseconds and request
# count per window; one backend machine is assumed.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Number of trusted reverse-proxy hops. Fly Proxy is one hop in production.
TRUST_PROXY_HOPS=0
